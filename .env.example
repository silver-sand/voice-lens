# Pollinations App Key (get yours from https://enter.pollinations.ai)
VITE_POLLINATIONS_APP_KEY=your-app-key-here

# Redirect URI for OAuth callback (must match the URL registered with your app key)
# For local development:
VITE_REDIRECT_URI=http://localhost:5173

# For production, use your deployed URL:
# VITE_REDIRECT_URI=https://your-domain.com